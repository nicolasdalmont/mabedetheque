# --- Neon Postgres ---
# Connection string, only needed for running migrations locally (psql) or scripts.
# Not read by the app at runtime (the app talks to Postgres only through the Data API).
NEON_DATABASE_URL=

# --- Neon Data API ---
# Postgres database > Data API > "Data API URL" in the Neon console.
NEXT_PUBLIC_NEON_DATA_API_URL=

# --- Neon Managed Better Auth ---
# Postgres database > Branch > Auth > "Base URL" in the Neon console.
NEON_AUTH_BASE_URL=
# Secret used to sign the app's own session cookie (min. 32 chars). Generate with:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Neon Object Storage ---
# Created when you enable Object Storage and generate a credential for the branch.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=mabedetheque-covers
